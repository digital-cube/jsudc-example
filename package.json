{
  "name": "jsudc",
  "private": true,
  "type": "module",
  "description": "Universal Data Collection, all in TypeScript",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
