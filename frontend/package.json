{
  "name": "@jsudc/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "jsudc example app: React 19 + Vite, the shell (menu, routes, pickers) around @jsudc/react's data view.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p cypress/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cy:run": "cypress run",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@jsudc/core": "^0.1.1",
    "@jsudc/react": "^0.1.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^8.21.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
