{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["cypress", "node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": false,
    "paths": {
      "@jsudc/core": ["../../packages/udc-core/src/index.ts"],
      "@jsudc/core/client": ["../../packages/udc-core/src/client.ts"]
    }
  },
  "include": ["**/*.ts", "../cypress.config.ts"]
}
