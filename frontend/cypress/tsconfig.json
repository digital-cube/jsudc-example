{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["cypress", "node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": false
  },
  "include": ["**/*.ts", "../cypress.config.ts"]
}
