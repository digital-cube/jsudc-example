{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@jsudc/core": ["../packages/udc-core/src/index.ts"],
      "@jsudc/core/client": ["../packages/udc-core/src/client.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
