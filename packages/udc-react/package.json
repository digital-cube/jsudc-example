{
  "name": "@jsudc/react",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "React components for UDC collections: the data view with its table, cards, kanban, calendar, tree, map and chart renderers, the schema editor, the hooks over @jsudc/core's client, i18n, theme and a compiled stylesheet.",
  "keywords": [
    "udc",
    "jsudc",
    "universal-data-collection",
    "react",
    "data-table",
    "kanban",
    "calendar",
    "tanstack-query",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "DigitalCube",
  "repository": "github:digital-cube/jsudc-react",
  "homepage": "https://github.com/digital-cube/jsudc-react#readme",
  "bugs": "https://github.com/digital-cube/jsudc-react/issues",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify && node -e \"require('node:fs').copyFileSync('src/tokens.css', 'dist/tokens.css')\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jsudc/core": "github:digital-cube/jsudc-core#v0.1.0",
    "clsx": "^2.1.1",
    "marked": "^18.1.2",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^8.21.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
