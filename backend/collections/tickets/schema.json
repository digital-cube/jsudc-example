{
  "version": "v1",
  "core_fields": [],
  "fields": {
    "board_id": {
      "type": "relation",
      "ref": "boards",
      "label_field": "name",
      "required": true,
      "index": true
    },
    "bucket_id": {
      "type": "relation",
      "ref": "buckets",
      "label_field": "name",
      "required": true,
      "index": true
    },
    "order": { "type": "integer", "index": true },
    "key": { "type": "string", "length": 16, "index": true },
