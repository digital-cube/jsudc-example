    "body": { "type": "text" },
    "priority": { "type": "enum", "values": ["low", "normal", "high", "urgent"], "index": true },
    "tags": { "type": "string_array" },
    "due": { "type": "date", "index": true },
    "assignees": { "type": "string_array" },
    "starts_at": { "type": "datetime", "index": true },
    "ends_at": { "type": "datetime" }
