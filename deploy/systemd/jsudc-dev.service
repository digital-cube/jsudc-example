# jsudc dev stack behind nginx vhost jsudc.igor.digitalcube.work.
# Runs `npm run dev` (builds packages/*/dist, then concurrently: the package
# watchers, Fastify backend + Vite with HMR) from the
# root checkout /home/digital/work/jsudc on main — deliberately the dev stack,
# not a production build.
# nginx :80 -> Vite 127.0.0.1:5101 -> (POST /udc/*, /healthz) Fastify 127.0.0.1:5100.
# 5101 instead of 5173: podman's rootlessport holds 5170-5189 on this machine.
# Node 24 from nvm (v24.19.0) is hardcoded in PATH/ExecStart: a unit has no
# shell profile, so no `nvm use`. Bump both lines when Node is upgraded.
#
# Installed by deploy/install.sh: ~/.config/systemd/user/jsudc-dev.service is a
# symlink to this file (edit here, then `systemctl --user daemon-reload`).
# Starts at boot via linger (loginctl enable-linger digital) + WantedBy=default.target.
# Restart: systemctl --user restart jsudc-dev   Logs: journalctl --user -u jsudc-dev -f
[Unit]
Description=jsudc dev stack (Fastify :5100 + Vite :5101)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/digital/work/jsudc
Environment=PORT=5100
Environment=HOST=127.0.0.1
Environment=VITE_PORT=5101
Environment=__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=jsudc.igor.digitalcube.work
Environment=PATH=/home/digital/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/digital/.nvm/versions/node/v24.19.0/bin/npm run dev
Restart=on-failure
RestartSec=3
KillMode=mixed

[Install]
WantedBy=default.target
